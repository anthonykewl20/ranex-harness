{
  "$schema": "https://ranex.dev/theme.json",
  "defs": {
    "darkGround": "#0E151D",
    "darkSurface": "#16202A",
    "darkSurface2": "#121B24",
    "darkInk": "#E9EDF1",
    "darkInkSoft": "#9DACB9",
    "darkLine": "#26333F",
    "darkLineStrong": "#3A4B59",
    "darkAccent": "#7FB0DC",
    "darkAccentStrong": "#9CC3E8",
    "darkAccentTint": "#1A2836",
    "darkPass": "#4FB27E",
    "darkPassBg": "#14281E",
    "darkFail": "#E07B6F",
    "darkFailBg": "#33201D",
    "darkWarn": "#D9A441",
    "darkWarnBg": "#2A2114",
    "darkInfo": "#6FC3C8",
    "darkInfoBg": "#13272A",
    "darkHighlight": "#A99BE0",
    "lightGround": "#F4F6F7",
    "lightSurface": "#FFFFFF",
    "lightSurface2": "#EDF1F3",
    "lightInk": "#1B2733",
    "lightInkSoft": "#52616E",
    "lightLine": "#D9E0E4",
    "lightLineStrong": "#B9C4CC",
    "lightAccent": "#2B5C8A",
    "lightAccentStrong": "#234C73",
    "lightAccentTint": "#E7EEF5",
    "lightPass": "#1E7A45",
    "lightPassBg": "#E7F2EB",
    "lightFail": "#B23A32",
    "lightFailBg": "#F7E9E7",
    "lightWarn": "#8A6114",
    "lightWarnBg": "#FAF0DC",
    "lightInfo": "#1F6E73",
    "lightInfoBg": "#E3F1F2",
    "lightHighlight": "#6A4FB0"
  },
  "theme": {
    "primary": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "secondary": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "accent": {
      "dark": "darkHighlight",
      "light": "lightHighlight"
    },
    "error": {
      "dark": "darkFail",
      "light": "lightFail"
    },
    "warning": {
      "dark": "darkWarn",
      "light": "lightWarn"
    },
    "success": {
      "dark": "darkPass",
      "light": "lightPass"
    },
    "info": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "text": {
      "dark": "darkInk",
      "light": "lightInk"
    },
    "textMuted": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "background": {
      "dark": "darkGround",
      "light": "lightGround"
    },
    "backgroundPanel": {
      "dark": "darkSurface2",
      "light": "lightSurface2"
    },
    "backgroundElement": {
      "dark": "darkSurface",
      "light": "lightSurface"
    },
    "border": {
      "dark": "darkLine",
      "light": "lightLine"
    },
    "borderActive": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "borderSubtle": {
      "dark": "darkLineStrong",
      "light": "lightLineStrong"
    },
    "diffAdded": {
      "dark": "darkPass",
      "light": "lightPass"
    },
    "diffRemoved": {
      "dark": "darkFail",
      "light": "lightFail"
    },
    "diffContext": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "diffHunkHeader": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "diffHighlightAdded": {
      "dark": "darkPass",
      "light": "lightPass"
    },
    "diffHighlightRemoved": {
      "dark": "darkFail",
      "light": "lightFail"
    },
    "diffAddedBg": {
      "dark": "darkPassBg",
      "light": "lightPassBg"
    },
    "diffRemovedBg": {
      "dark": "darkFailBg",
      "light": "lightFailBg"
    },
    "diffContextBg": {
      "dark": "darkSurface2",
      "light": "lightSurface2"
    },
    "diffLineNumber": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "diffAddedLineNumberBg": {
      "dark": "darkPassBg",
      "light": "lightPassBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "darkFailBg",
      "light": "lightFailBg"
    },
    "markdownText": {
      "dark": "darkInk",
      "light": "lightInk"
    },
    "markdownHeading": {
      "dark": "darkAccentStrong",
      "light": "lightAccentStrong"
    },
    "markdownLink": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "markdownLinkText": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "markdownCode": {
      "dark": "darkPass",
      "light": "lightPass"
    },
    "markdownBlockQuote": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "markdownEmph": {
      "dark": "darkWarn",
      "light": "lightWarn"
    },
    "markdownStrong": {
      "dark": "darkAccentStrong",
      "light": "lightAccentStrong"
    },
    "markdownHorizontalRule": {
      "dark": "darkLine",
      "light": "lightLine"
    },
    "markdownListItem": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "markdownListEnumeration": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "markdownImage": {
      "dark": "darkAccent",
      "light": "lightAccent"
    },
    "markdownImageText": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "markdownCodeBlock": {
      "dark": "darkInk",
      "light": "lightInk"
    },
    "syntaxComment": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "syntaxKeyword": {
      "dark": "darkHighlight",
      "light": "lightHighlight"
    },
    "syntaxFunction": {
      "dark": "darkAccentStrong",
      "light": "lightAccentStrong"
    },
    "syntaxVariable": {
      "dark": "darkInk",
      "light": "lightInk"
    },
    "syntaxString": {
      "dark": "darkPass",
      "light": "lightPass"
    },
    "syntaxNumber": {
      "dark": "darkWarn",
      "light": "lightWarn"
    },
    "syntaxType": {
      "dark": "darkInfo",
      "light": "lightInfo"
    },
    "syntaxOperator": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    },
    "syntaxPunctuation": {
      "dark": "darkInkSoft",
      "light": "lightInkSoft"
    }
  }
}
