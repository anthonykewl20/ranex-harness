#!/usr/bin/env bash
set -euo pipefail
APP=opencode

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
OpenCode Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.0.180)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://opencode.ai/install | bash
    curl -fsSL https://opencode.ai/install | bash -s -- --version 1.0.180
    ./install --binary /path/to/opencode

Environment:
    OPENCODE_INSTALL_PUBKEY
        Optional public key (file path or literal). When set, the downloaded
        archive must carry a detached signature verifying against this key
        before anything is extracted. The signature is fetched from the
        release as <archive>.minisig or <archive>.sig.

        Two conventions are supported; the format actually used is selected
        from what the release publishes and the verifier you have installed:
        - minisign: minisign-format signature, verified with the minisign
          tool against a minisign public key.
        - openssl (>= 1.1.1): raw Ed25519 signature over the exact archive
          bytes. Publish it with:
              openssl pkeyutl -sign -rawin -inkey ed25519.key -in <archive> > <archive>.sig
          The key may be PEM, base64 raw 32-byte, or base64 DER.

        A missing signature, a bad signature, or no verifiable pair
        (published formats no installed verifier can check) aborts the
        install.
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""
GITHUB_TOKEN_FOR_INSTALL="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
gh_config_arg=()
gh_cfg=""
if [ -n "$GITHUB_TOKEN_FOR_INSTALL" ]; then
    gh_cfg=$(mktemp)
    printf 'header = "Authorization: Bearer %s"\n' "$GITHUB_TOKEN_FOR_INSTALL" > "$gh_cfg"
    chmod 600 "$gh_cfg"
    gh_config_arg=(--config "$gh_cfg")
fi
trap '[ -z "${gh_cfg:-}" ] || rm -f "$gh_cfg"' EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.opencode/bin
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        url="https://github.com/anomalyco/opencode/releases/latest/download/$filename"
        set +o pipefail
        specific_version=$(curl -s "${gh_config_arg[@]+"${gh_config_arg[@]}"}" https://api.github.com/repos/anomalyco/opencode/releases/latest | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')
        version_status=$?
        set -o pipefail

        if [ "$version_status" -ne 0 ] || [ -z "$specific_version" ]; then
            echo -e "${RED}Failed to fetch version information${NC}"
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        url="https://github.com/anomalyco/opencode/releases/download/v${requested_version}/$filename"
        specific_version=$requested_version

        # Verify the release exists before downloading
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "${gh_config_arg[@]+"${gh_config_arg[@]}"}" "https://github.com/anomalyco/opencode/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/anomalyco/opencode/releases${NC}"
            exit 1
        fi
    fi
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v opencode >/dev/null 2>&1; then
        opencode_path=$(which opencode)

        ## Check the installed version
        installed_version=$(opencode --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        else
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/opencode_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"
    chmod 600 "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --trace-ascii "$tracefile" -s -L "${gh_config_arg[@]+"${gh_config_arg[@]}"}" -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

# Fail-closed checksum verification: the downloaded archive must match the
# SHA256SUMS manifest from the same release channel before anything is
# extracted, moved, or executed. A missing manifest, a missing per-file entry,
# or a hash mismatch aborts the install.
#
# Trust note: SHA256SUMS and the archive ship from the same release, so this
# protects against CDN corruption and MITM tampering with the download — NOT
# against a fully compromised release account, which could rewrite the
# checksums too. Setting OPENCODE_INSTALL_PUBKEY (see verify_signature below)
# closes that gap: the archive must then also carry a detached signature from
# a key pinned outside the release channel before anything is extracted.
verify_checksum() {
    local archive="$1"
    local sums_url="$2"
    local sums_file="${archive}.SHA256SUMS"

    if ! curl -sfL "${gh_config_arg[@]+"${gh_config_arg[@]}"}" -o "$sums_file" "$sums_url"; then
        print_message error "Failed to download checksum manifest: $sums_url"
        print_message error "Refusing to install: archive integrity cannot be verified"
        exit 1
    fi

    if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
        print_message error "Neither sha256sum nor shasum is available; cannot verify the archive"
        print_message error "Refusing to install: archive integrity cannot be verified"
        exit 1
    fi

    local actual
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$archive" | awk '{print $1}')
    else
        actual=$(shasum -a 256 "$archive" | awk '{print $1}')
    fi
    actual=$(printf '%s' "$actual" | tr '[:upper:]' '[:lower:]')

    # Match the exact archive filename's entry (sha256sum format: "<hash>  <file>",
    # with a "*" prefix on the filename in binary mode).
    local expected
    expected=$(awk -v file="$filename" \
        'length($1) == 64 && $1 ~ /^[0-9a-fA-F]+$/ && ($2 == file || $2 == "*" file) { print tolower($1); exit }' \
        "$sums_file")

    if [ -z "$expected" ]; then
        print_message error "No SHA256SUMS entry for $filename in $sums_url"
        print_message error "Expected: (no entry for this file)  Actual: $actual"
        print_message error "Refusing to install: archive integrity cannot be verified"
        exit 1
    fi

    if [ "$actual" != "$expected" ]; then
        print_message error "Checksum mismatch for $filename"
        print_message error "Expected: $expected"
        print_message error "Actual:   $actual"
        print_message error "Refusing to install: archive integrity cannot be verified"
        exit 1
    fi

    print_message info "${MUTED}Checksum verified: ${NC}$actual"
}

# Optional, opt-in signature verification: OPENCODE_INSTALL_PUBKEY pins a
# public key that lives OUTSIDE the release channel. Unlike SHA256SUMS, a
# pinned key survives a fully compromised release account: the attacker can
# republish the archive and its checksums, but cannot forge a signature that
# the pinned key would produce.
#
# The signature is fetched from the same release directory as the archive:
# both <archive>.minisig and <archive>.sig are probed — one of them is
# REQUIRED when the pubkey is set. Selection is capability-driven (see
# verify_signature): a published format whose verifier is not installed is
# skipped, never guessed at.
#
#   minisign  Signature in minisign format (leading "untrusted comment:"
#             line), verified with the minisign binary:
#                 minisign -V -m <archive> -x <sig> -P <pubkey>
#             minisign-format files are never parsed by hand here; without
#             the minisign binary they are a hard error, not a guess.
#
#   openssl   Raw detached Ed25519 signature over the exact archive bytes,
#             verified with: openssl pkeyutl -verify -pubin -rawin.
#             Produced at release time by:
#                 openssl pkeyutl -sign -rawin -inkey ed25519.key \
#                     -in <archive> > <archive>.sig
#             Requires OpenSSL >= 1.1.1 (Ed25519 support).
#
# OPENCODE_INSTALL_PUBKEY holds a key file path or the literal key: a
# minisign pubkey (file, or bare base64 line: base64("Ed" + 8-byte key id +
# raw key)), a raw 32-byte Ed25519 key as base64, a base64 DER
# SubjectPublicKeyInfo, or a PEM public key (openssl paths only).
verify_signature() {
    local archive="$1"
    local sig_base_url="$2"

    # Capability probe first: which verifiers can actually run here? A raw
    # Ed25519 .sig needs openssl >= 1.1.1 (-rawin); a .minisig needs the
    # minisign binary. Older openssl builds cannot verify .sig files at all.
    local have_minisign=false
    if command -v minisign >/dev/null 2>&1; then have_minisign=true; fi
    local have_openssl_raw=false
    if command -v openssl >/dev/null 2>&1 && openssl pkeyutl -help 2>&1 | grep -q -- '-rawin'; then
        have_openssl_raw=true
    fi
    if [ "$have_minisign" = false ] && [ "$have_openssl_raw" = false ]; then
        print_message error "OPENCODE_INSTALL_PUBKEY set but no verifier available (install minisign or openssl >= 1.1.1)"
        print_message error "Refusing to install: signature verification required"
        exit 1
    fi

    # Probe both published formats up front so the error path can name what
    # the release publishes versus what is installed.
    local minisig_file=""
    if curl -sfL "${gh_config_arg[@]+"${gh_config_arg[@]}"}" -o "${archive}.minisig" "${sig_base_url}/${filename}.minisig" && [ -s "${archive}.minisig" ]; then
        minisig_file="${archive}.minisig"
    else
        rm -f "${archive}.minisig"
    fi
    local rawsig_file=""
    if curl -sfL "${gh_config_arg[@]+"${gh_config_arg[@]}"}" -o "${archive}.sig" "${sig_base_url}/${filename}.sig" && [ -s "${archive}.sig" ]; then
        rawsig_file="${archive}.sig"
    else
        rm -f "${archive}.sig"
    fi

    # Select the signature format by verifier capability, not publication
    # order: a pair is workable only when the format is published AND its
    # verifier is installed. Preference selects (.sig + openssl) first —
    # openssl is near-universal — then (.minisig + minisign). With the
    # pubkey pinned, no workable pair is a hard error, never a guess.
    local sig_file=""
    if [ -n "$rawsig_file" ] && [ "$have_openssl_raw" = true ]; then
        sig_file="$rawsig_file"
    elif [ -n "$minisig_file" ] && [ "$have_minisign" = true ]; then
        sig_file="$minisig_file"
    fi
    if [ -z "$sig_file" ]; then
        local published=""
        if [ -n "$minisig_file" ]; then published="${filename}.minisig"; fi
        if [ -n "$rawsig_file" ]; then published="${published:+$published }${filename}.sig"; fi
        if [ -z "$published" ]; then published="(none)"; fi
        local verifiers=""
        if [ "$have_minisign" = true ]; then verifiers="minisign"; fi
        if [ "$have_openssl_raw" = true ]; then verifiers="${verifiers:+$verifiers, }openssl (raw Ed25519)"; fi
        print_message error "Signature required but none verifiable (OPENCODE_INSTALL_PUBKEY is set)"
        print_message error "Published by this release: $published"
        print_message error "Verifiers installed: $verifiers"
        print_message error "Refusing to install: release signature cannot be verified"
        exit 1
    fi

    # Resolve the pinned public key: an existing file path, or literal key
    # material.
    local key_text="${OPENCODE_INSTALL_PUBKEY:-}"
    if [ -f "$key_text" ]; then
        key_text=$(cat "$key_text")
    fi

    local key_b64=""
    local ms_pubkey=""
    local pem_key=""
    case "$key_text" in
        "untrusted comment:"*)
            key_b64=$(printf '%s\n' "$key_text" | sed -n '2p' | tr -d '[:space:]')
            ms_pubkey="$key_b64"
            ;;
        -----BEGIN*)
            pem_key="$key_text"
            ;;
        *)
            key_b64=$(printf '%s' "$key_text" | tr -d '[:space:]')
            # minisign pubkey is 56 chars (42 bytes); raw key 43/44 chars
            # (32 bytes); DER SubjectPublicKeyInfo 60 chars (44 bytes).
            case "$(printf '%s' "$key_b64" | wc -c)" in
                56) ms_pubkey="$key_b64" ;;
                43|44|60) ;;
                *)
                    print_message error "Unsupported OPENCODE_INSTALL_PUBKEY value: expected a key file path, minisign key, base64 raw/DER Ed25519 key, or PEM"
                    print_message error "Refusing to install: signature verification required"
                    exit 1
                    ;;
            esac
            ;;
    esac

    # Dispatch on the signature file's actual format.
    local sig_kind
    if [ "$(head -c 18 "$sig_file")" = "untrusted comment:" ]; then
        sig_kind=minisign
    else
        sig_kind=raw
    fi

    if [ "$sig_kind" = minisign ]; then
        if ! command -v minisign >/dev/null 2>&1; then
            print_message error "Signature $sig_file is in minisign format, but minisign is not installed"
            print_message error "Install minisign, or publish a raw Ed25519 .sig instead (see --help)"
            print_message error "Refusing to install: signature verification required"
            exit 1
        fi
        if [ -z "$ms_pubkey" ]; then
            print_message error "A minisign-format signature requires a minisign public key; OPENCODE_INSTALL_PUBKEY does not contain one"
            print_message error "Refusing to install: signature verification required"
            exit 1
        fi
        local ms_out
        if ! ms_out=$(minisign -V -m "$archive" -x "$sig_file" -P "$ms_pubkey" 2>&1); then
            print_message error "Signature verification failed (minisign)"
            print_message error "$ms_out"
            print_message error "Refusing to install: archive signature does not match the pinned public key"
            exit 1
        fi
        print_message info "${MUTED}Signature verified (minisign Ed25519) against OPENCODE_INSTALL_PUBKEY${NC}"
        return 0
    fi

    # Raw detached Ed25519 via OpenSSL (>= 1.1.1 for Ed25519 and -rawin).
    if ! command -v openssl >/dev/null 2>&1; then
        print_message error "Raw Ed25519 signature found but openssl is not installed (install openssl, or minisign plus a .minisig)"
        print_message error "Refusing to install: signature verification required"
        exit 1
    fi
    if ! openssl pkeyutl -help 2>&1 | grep -q -- '-rawin'; then
        print_message error "openssl lacks raw Ed25519 verification (-rawin); OpenSSL >= 1.1.1 is required"
        print_message error "Refusing to install: signature verification required"
        exit 1
    fi

    # Materialize the public key as a file: PEM as-is, or base64 decoded and
    # wrapped into a 44-byte Ed25519 SubjectPublicKeyInfo (DER).
    local key_file="${archive}.pubkey.pem"
    local key_form=PEM
    if [ -z "$pem_key" ]; then
        key_file="${archive}.pubkey.der"
        key_form=DER
        local blob_file="${archive}.pubkey.blob"
        if ! printf '%s' "$key_b64" | openssl base64 -d -A > "$blob_file" 2>/dev/null || [ ! -s "$blob_file" ]; then
            print_message error "OPENCODE_INSTALL_PUBKEY is not valid base64"
            print_message error "Refusing to install: signature verification required"
            exit 1
        fi
        local blob_len
        blob_len=$(wc -c < "$blob_file")
        # Ed25519 SubjectPublicKeyInfo prefix: SEQUENCE(26) { SEQUENCE(5)
        # { OID 1.3.101.112 }, BIT STRING(33) { 00, raw key } }
        case "$blob_len" in
            42)
                # minisign pubkey: "Ed" + 8-byte key id + raw key
                if [ "$(head -c 2 "$blob_file")" != "Ed" ]; then
                    print_message error "Malformed minisign public key (missing Ed prefix)"
                    print_message error "Refusing to install: signature verification required"
                    rm -f "$blob_file"
                    exit 1
                fi
                printf '\060\052\060\005\006\003\053\145\160\003\041\000' > "$key_file"
                tail -c 32 "$blob_file" >> "$key_file"
                ;;
            32)
                printf '\060\052\060\005\006\003\053\145\160\003\041\000' > "$key_file"
                cat "$blob_file" >> "$key_file"
                ;;
            44)
                # already a DER SubjectPublicKeyInfo
                if [ "$(head -c 2 "$blob_file" | od -An -tx1 | tr -d '[:space:]')" != "302a" ]; then
                    print_message error "Decoded key is 44 bytes but not an Ed25519 SubjectPublicKeyInfo"
                    print_message error "Refusing to install: signature verification required"
                    rm -f "$blob_file"
                    exit 1
                fi
                cp "$blob_file" "$key_file"
                ;;
            *)
                print_message error "Decoded OPENCODE_INSTALL_PUBKEY key is $blob_len bytes; expected 32 (raw), 42 (minisign), or 44 (DER)"
                print_message error "Refusing to install: signature verification required"
                rm -f "$blob_file"
                exit 1
                ;;
        esac
        rm -f "$blob_file"
    else
        printf '%s\n' "$pem_key" > "$key_file"
    fi

    local ssl_out
    if ! ssl_out=$(openssl pkeyutl -verify -pubin -keyform "$key_form" -inkey "$key_file" -rawin -in "$archive" -sigfile "$sig_file" 2>&1); then
        print_message error "Signature verification failed (openssl raw Ed25519)"
        print_message error "$ssl_out"
        print_message error "Refusing to install: archive signature does not match the pinned public key"
        rm -f "$key_file"
        exit 1
    fi
    rm -f "$key_file"
    print_message info "${MUTED}Signature verified (Ed25519 via openssl) against OPENCODE_INSTALL_PUBKEY${NC}"
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}opencode ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/opencode_install_$$"
    mkdir -p "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        curl -# -L "${gh_config_arg[@]+"${gh_config_arg[@]}"}" -o "$tmp_dir/$filename" "$url"
    fi

    # Verify integrity before extraction; the manifest lives next to the archive
    # on the same release channel.
    verify_checksum "$tmp_dir/$filename" "${url%/*}/SHA256SUMS"

    # Optional signature check against a pinned out-of-band public key; when
    # unset, same-channel checksums are the whole protection — say so.
    if [ -n "${OPENCODE_INSTALL_PUBKEY:-}" ]; then
        verify_signature "$tmp_dir/$filename" "${url%/*}"
    else
        print_message info "${MUTED}Note: checksums ship with the release and cannot detect a compromised release account; set OPENCODE_INSTALL_PUBKEY to require a signature (see --help)${NC}"
    fi

    if [ "$os" = "linux" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi

    mv "$tmp_dir/opencode" "$INSTALL_DIR"
    chmod 755 "${INSTALL_DIR}/opencode"
    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}opencode ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/opencode"
    chmod 755 "${INSTALL_DIR}/opencode"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# opencode" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}opencode ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${MUTED}                    ${NC}             ▄     "
echo -e "${MUTED}█▀▀█ █▀▀█ █▀▀█ █▀▀▄ ${NC}█▀▀▀ █▀▀█ █▀▀█ █▀▀█"
echo -e "${MUTED}█░░█ █░░█ █▀▀▀ █░░█ ${NC}█░░░ █░░█ █░░█ █▀▀▀"
echo -e "${MUTED}▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ${NC}▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀"
echo -e ""
echo -e ""
echo -e "${MUTED}OpenCode includes free models, to start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "opencode      ${MUTED}# Run command${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}https://opencode.ai/docs"
echo -e ""
echo -e ""
